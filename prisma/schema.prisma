// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String
  role          UserRole  @default(EDITOR)
  image         String?
  accounts      Account[]
  sessions      Session[]
  auditoria     Auditoria[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("utilizadores")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Viatura {
  id          String           @id @default(cuid())
  tipo        EquipamentoTipo  @default(VEICULO)
  matricula   String?          @unique
  parque      String?
  peso        String?          // Peso em toneladas (ex: 1T, 1T5, 2T5) - apenas para máquinas
  modelo      String
  marca       String
  ano         Int
  foto        String?
  descricao   String?          @db.Text
  qrCode      String?          @db.LongText
  // Campos de visibilidade pública
  publicoFoto        Boolean  @default(false)
  publicoDescricao   Boolean  @default(false)
  publicoMarca       Boolean  @default(true)
  publicoModelo      Boolean  @default(true)
  publicoAno         Boolean  @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  documentos  Documento[]
  eventos     Evento[]

  @@map("viaturas")
}

model Documento {
  id          String   @id @default(cuid())
  viaturaId   String
  titulo      String
  descricao   String?  @db.Text
  arquivo     String
  tipo        String
  dataVencimento DateTime?
  publico     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  viatura     Viatura  @relation(fields: [viaturaId], references: [id], onDelete: Cascade)

  @@index([viaturaId])
  @@index([publico])
  @@index([createdAt])
  @@map("documentos")
}

model Evento {
  id          String   @id @default(cuid())
  viaturaId   String
  titulo      String
  descricao   String?  @db.Text
  tipo        EventoTipo
  data        DateTime
  custo       Float?
  publico     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  viatura     Viatura  @relation(fields: [viaturaId], references: [id], onDelete: Cascade)

  @@index([viaturaId])
  @@index([publico])
  @@index([data])
  @@map("eventos")
}

enum UserRole {
  ADMIN
  EDITOR
}

enum EquipamentoTipo {
  VEICULO
  MAQUINA
}

enum EventoTipo {
  MANUTENCAO
  REPARACAO
  INSPECAO
  COMBUSTIVEL
  PECAS_TROCADAS
  REVISAO
  OUTRO
}

model Auditoria {
  id          String   @id @default(cuid())
  userId      String
  acao        String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  entidade    String   // VIATURA, DOCUMENTO, EVENTO, USUARIO, etc.
  entidadeId  String?  // ID da entidade afetada
  detalhes    String?  @db.Text // Detalhes adicionais da ação
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([entidade])
  @@map("auditoria")
}

